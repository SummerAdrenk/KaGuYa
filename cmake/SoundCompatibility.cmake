# 默认Sound保留Unicode ABI；旧ANSI候选不自动发布，不能用字符内容猜调用者版本。
function(kaguya_register_sound_compatibility)
  set(_runtime_names SoundState SoundRegistry SoundRoots SoundDeviceDrivers SoundAnsiText)
  get_target_property(_sound_sources Sound SOURCES)
  set(_runtime_sources "")
  foreach(_name IN LISTS _runtime_names)
    set(_path "${PROJECT_SOURCE_DIR}/Sound/src/${_name}.cpp")
    if(NOT _path IN_LIST _sound_sources)
      message(FATAL_ERROR "Sound runtime source missing from imported project: ${_path}")
    endif()
    list(APPEND _runtime_sources "${_path}")
    list(REMOVE_ITEM _sound_sources "${_path}")
  endforeach()
  set_property(TARGET Sound PROPERTY SOURCES "${_sound_sources}")
  add_library(KaGuYaSoundRuntime STATIC ${_runtime_sources})
  set_target_properties(KaGuYaSoundRuntime PROPERTIES
    ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/artifacts/lib/${CMAKE_BUILD_TYPE}/x86"
    PDB_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/artifacts/symbols/KaGuYaSoundRuntime")
  foreach(_source IN LISTS _runtime_sources)
    foreach(_property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS)
      get_source_file_property(_value "${_source}" TARGET_DIRECTORY Sound ${_property})
      if("${_value}" MATCHES "NOTFOUND$")
        message(FATAL_ERROR "Missing ${_property} for ${_source}")
      endif()
      set_source_files_properties("${_source}" TARGET_DIRECTORY KaGuYaSoundRuntime PROPERTIES ${_property} "${_value}")
    endforeach()
  endforeach()
  target_link_libraries(KaGuYaSoundRuntime PUBLIC KaGuYaSoundCore KaGuYaLogging)
  target_link_libraries(Sound PRIVATE KaGuYaSoundRuntime)

  set(_exports "${PROJECT_SOURCE_DIR}/Sound/src/Exports.cpp")
  set(_entry "${PROJECT_SOURCE_DIR}/Sound/src/dllmain.cpp")
  add_library(SoundAnsiPolling SHARED EXCLUDE_FROM_ALL "${_exports}" "${_entry}"
    "${PROJECT_SOURCE_DIR}/Sound/abi/ThreadAnsiPolling.def")
  foreach(_source IN ITEMS "${_exports}" "${_entry}")
    foreach(_property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS)
      get_source_file_property(_value "${_source}" TARGET_DIRECTORY Sound ${_property})
      if("${_value}" MATCHES "NOTFOUND$")
        message(FATAL_ERROR "Missing ${_property} for Sound ABI entry")
      endif()
      set_source_files_properties("${_source}" TARGET_DIRECTORY SoundAnsiPolling PROPERTIES ${_property} "${_value}")
    endforeach()
  endforeach()
  target_compile_definitions(SoundAnsiPolling PRIVATE KAGUYA_SOUND_THREAD_ANSI_ABI=1)
  get_target_property(_libraries Sound LINK_LIBRARIES)
  get_target_property(_options Sound LINK_OPTIONS)
  target_link_libraries(SoundAnsiPolling PRIVATE ${_libraries})
  target_link_options(SoundAnsiPolling PRIVATE ${_options})
  set(_candidate "${CMAKE_BINARY_DIR}/compatibility-dlls/thread-ansi-polling")
  set_target_properties(SoundAnsiPolling PROPERTIES
    OUTPUT_NAME Sound WINDOWS_EXPORT_ALL_SYMBOLS OFF
    RUNTIME_OUTPUT_DIRECTORY "${_candidate}" LIBRARY_OUTPUT_DIRECTORY "${_candidate}"
    ARCHIVE_OUTPUT_DIRECTORY "${_candidate}/symbols" PDB_OUTPUT_DIRECTORY "${_candidate}/symbols")
endfunction()
