# 游戏编号只选择资源编译单元；所有目标共享同一份运行时静态库。
function(kaguya_register_game_targets)
  set(_catalog_path "${PROJECT_SOURCE_DIR}/Start/games/catalog.json")
  file(READ "${_catalog_path}" _catalog)
  set(_behavior_path "${PROJECT_SOURCE_DIR}/Start/games/behavior.json")
  file(READ "${_behavior_path}" _behavior)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_catalog_path}" "${_behavior_path}")
  string(JSON _count LENGTH "${_catalog}" games)
  math(EXPR _last "${_count} - 1")
  set(_main "${PROJECT_SOURCE_DIR}/Start/src/main.cpp")
  get_source_file_property(_main_options "${_main}" TARGET_DIRECTORY Start COMPILE_OPTIONS)
  get_source_file_property(_main_definitions "${_main}" TARGET_DIRECTORY Start COMPILE_DEFINITIONS)
  get_source_file_property(_main_includes "${_main}" TARGET_DIRECTORY Start INCLUDE_DIRECTORIES)
  get_target_property(_libraries Start LINK_LIBRARIES)
  get_target_property(_link_options Start LINK_OPTIONS)
  foreach(_value _main_options _main_definitions _main_includes _libraries _link_options)
    if("${${_value}}" MATCHES "NOTFOUND$")
      message(FATAL_ERROR "Missing original Start build property: ${_value}")
    endif()
  endforeach()
  set(_available "")
  set(_default_target "")
  set(_targets "")
  foreach(_index RANGE 0 ${_last})
    string(JSON _number GET "${_catalog}" games ${_index} number)
    string(JSON _slug GET "${_catalog}" games ${_index} slug)
    string(JSON _public GET "${_catalog}" games ${_index} build_target)
    if(NOT _slug MATCHES "^[a-z0-9]+(-[a-z0-9]+)*$" OR NOT _public MATCHES "^Start[0-9][0-9]$")
      message(FATAL_ERROR "Invalid game catalog entry: ${_slug} / ${_public}")
    endif()
    if(_public IN_LIST _targets OR _slug IN_LIST _available)
      message(FATAL_ERROR "Duplicate game catalog target or directory")
    endif()
    set(_resources "${PROJECT_SOURCE_DIR}/Start/resources/${_slug}")
    set(_entry "${_resources}/Resources.rc")
    set(_metadata "${_resources}/ResourceMetadata.json")
    if(NOT EXISTS "${_entry}" OR NOT EXISTS "${_metadata}")
      message(STATUS "Resources not prepared yet: ${_public} (${_slug})")
      continue()
    endif()
    if(_number EQUAL 18)
      set(_native Start)
      set_target_properties(Start PROPERTIES EXCLUDE_FROM_ALL TRUE)
    else()
      set(_native "${_public}Native")
      add_executable(${_native} WIN32 EXCLUDE_FROM_ALL "${_main}" "${_entry}")
      target_include_directories(${_native} PRIVATE ${_main_includes})
      foreach(_option IN LISTS _main_options)
        target_compile_options(${_native} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${_option}>")
      endforeach()
      target_compile_definitions(${_native} PRIVATE ${_main_definitions} KAGUYA_GAME_NUMBER=${_number})
      target_link_libraries(${_native} PRIVATE ${_libraries})
      target_link_options(${_native} PRIVATE ${_link_options})
    endif()
    set_target_properties(${_native} PROPERTIES
      OUTPUT_NAME Start
      RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/games/${_slug}"
      PDB_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/symbols/${_slug}")
    string(JSON _title_family GET "${_behavior}" games "${_slug}" title_family)
    string(JSON _title_gate GET "${_behavior}" games "${_slug}" title_name_gate)
    string(JSON _title_resources GET "${_behavior}" games "${_slug}" title_button_resources)
    string(JSON _title_recovery GET "${_behavior}" games "${_slug}" title_phase5_recovery)
    string(JSON _sound_settings ERROR_VARIABLE _sound_settings_missing GET "${_behavior}" games "${_slug}" sound_settings)
    if(_sound_settings_missing)
      set(_sound_settings Grouped)
    endif()
    if(NOT _sound_settings MATCHES "^(Grouped|Categorized)$")
      message(FATAL_ERROR "Invalid sound settings schema: ${_slug}")
    endif()
    string(JSON _startup_resources ERROR_VARIABLE _startup_resources_missing GET "${_behavior}" games "${_slug}" startup_resources)
    if(_startup_resources_missing)
      set(_startup_resources Mamatomo)
    endif()
    string(JSON _script_names GET "${_behavior}" games "${_slug}" script_names)
    if(NOT _startup_resources MATCHES "^(Mamatomo|BakuAne|Configured)$" OR NOT _script_names MATCHES "^(Mamatomo|[A-Za-z][A-Za-z0-9]*ScriptNames)$")
      message(FATAL_ERROR "Invalid startup or script-name profile: ${_slug}")
    endif()
    set(_script_names_include "")
    set(_script_names_provider MamatomoScriptNamedValueTables)
    if(NOT _script_names STREQUAL "Mamatomo")
      set(_names_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/ScriptNames.h")
      set(_names_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/ScriptNames.cpp")
      if(NOT EXISTS "${_names_header}" OR NOT EXISTS "${_names_source}")
        message(FATAL_ERROR "Missing audited script-name data: ${_slug}")
      endif()
      set(_script_names_include "#include \"${_names_header}\"")
      set(_script_names_provider "${_script_names}::Tables")
      target_sources(${_native} PRIVATE "${_names_source}" "${_names_header}")
      set_source_files_properties("${_names_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endif()
    string(JSON _wait_type TYPE "${_behavior}" games "${_slug}" wait_skip_result)
    if(NOT _wait_type STREQUAL "BOOLEAN")
      message(FATAL_ERROR "wait_skip_result must be an explicit JSON boolean: ${_slug}")
    endif()
    string(JSON _wait_value GET "${_behavior}" games "${_slug}" wait_skip_result)
    set(_wait_skip_result false)
    if(_wait_value)
      set(_wait_skip_result true)
    endif()
    string(JSON _restart_type TYPE "${_behavior}" games "${_slug}" restart_point)
    if(NOT _restart_type STREQUAL "BOOLEAN")
      message(FATAL_ERROR "restart_point must be an explicit JSON boolean: ${_slug}")
    endif()
    string(JSON _restart_value GET "${_behavior}" games "${_slug}" restart_point)
    set(_restart_point false)
    if(_restart_value)
      set(_restart_point true)
    endif()
    string(JSON _text_layout GET "${_behavior}" games "${_slug}" text_layout)
    if(NOT _text_layout MATCHES "^(Mamatomo|[A-Za-z][A-Za-z0-9]*TextData)$")
      message(FATAL_ERROR "Invalid text layout profile: ${_slug}")
    endif()
    set(_text_layout_include "")
    set(_text_layout_provider MamatomoTextWindowNativeDescriptors)
    if(NOT _text_layout STREQUAL "Mamatomo")
      set(_text_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/TextData.h")
      set(_text_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/TextData.cpp")
      if(NOT EXISTS "${_text_header}" OR NOT EXISTS "${_text_source}")
        message(FATAL_ERROR "Missing audited text layout data: ${_slug}")
      endif()
      set(_text_layout_include "#include \"${_text_header}\"")
      set(_text_layout_provider "${_text_layout}::Descriptors")
      target_sources(${_native} PRIVATE "${_text_source}" "${_text_header}")
      set_source_files_properties("${_text_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endif()
    string(JSON _countdown_type ERROR_VARIABLE _countdown_missing TYPE "${_behavior}" games "${_slug}" countdown_enabled)
    set(_countdown_enabled true)
    if(NOT _countdown_missing)
      if(NOT _countdown_type STREQUAL "BOOLEAN")
        message(FATAL_ERROR "countdown_enabled must be a JSON boolean: ${_slug}")
      endif()
      string(JSON _countdown_value GET "${_behavior}" games "${_slug}" countdown_enabled)
      if(NOT _countdown_value)
        set(_countdown_enabled false)
      endif()
    endif()
    if(NOT _title_family MATCHES "^(Unreviewed|LegacyComposedTitle|GuiTitleDialog)$"
       OR NOT _title_gate MATCHES "^(Unreviewed|EditableNameBits|SavedPreferenceOnly|PathSwitchAndSavedPreference)$"
       OR NOT _title_resources MATCHES "^(Unreviewed|Mamatomo|PureHolic|BunnysMama|BakuAne|Configured)$"
       OR NOT _title_recovery MATCHES "^(Unreviewed|ResetChildrenOnly|ResetChildrenAndParentInput)$")
      message(FATAL_ERROR "Invalid audited title profile: ${_slug}")
    endif()
    if(_title_family STREQUAL "GuiTitleDialog" AND
       (_title_resources STREQUAL "Unreviewed" OR _title_recovery STREQUAL "Unreviewed" OR
        NOT _title_gate MATCHES "^(SavedPreferenceOnly|PathSwitchAndSavedPreference)$"))
      message(FATAL_ERROR "Incomplete modern title profile: ${_slug}")
    endif()
    set(_title_data_include "")
    set(_title_data_initializer "")
    set(_title_data_reference nullptr)
    if(_title_resources STREQUAL "Configured")
      string(JSON _title_namespace GET "${_behavior}" games "${_slug}" title_data)
      if(NOT _title_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid title data namespace: ${_slug}")
      endif()
      set(_title_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/TitleData.h")
      set(_title_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/TitleData.cpp")
      if(NOT EXISTS "${_title_header}" OR NOT EXISTS "${_title_source}")
        message(FATAL_ERROR "Missing audited title data: ${_slug}")
      endif()
      set(_title_data_include "#include \"${_title_header}\"")
      set(_title_data_initializer "    static const TitleResourceProfile titleResources{\n        ${_title_namespace}::SharedBackground(), ${_title_namespace}::SharedButtons(),\n        ${_title_namespace}::BlackName(), ${_title_namespace}::OverlayName(),\n        ${_title_namespace}::BgmName(), ${_title_namespace}::ClickCue(), ${_title_namespace}::HoverCue(),\n        {${_title_namespace}::GivenNameMaxBytes(), ${_title_namespace}::FamilyNameMaxBytes()}};")
      set(_title_data_reference "&titleResources")
      target_sources(${_native} PRIVATE "${_title_source}" "${_title_header}")
      set_source_files_properties("${_title_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endif()
    set(_startup_data_include "")
    set(_startup_data_initializer "")
    set(_startup_data_reference nullptr)
    if(_startup_resources STREQUAL "Configured")
      string(JSON _startup_namespace GET "${_behavior}" games "${_slug}" startup_data)
      if(NOT _startup_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid startup data namespace: ${_slug}")
      endif()
      set(_startup_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/StartupData.h")
      set(_startup_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/StartupData.cpp")
      if(NOT EXISTS "${_startup_header}" OR NOT EXISTS "${_startup_source}")
        message(FATAL_ERROR "Missing audited startup data: ${_slug}")
      endif()
      set(_startup_data_include "#include \"${_startup_header}\"")
      set(_startup_data_initializer "    static const StartupResourceProfile startupResources{\n        ${_startup_namespace}::Tool(), ${_startup_namespace}::ToolRelation(),\n        ${_startup_namespace}::WaitMark(), ${_startup_namespace}::Selection(), ${_startup_namespace}::Opacity()};")
      set(_startup_data_reference "&startupResources")
      target_sources(${_native} PRIVATE "${_startup_source}" "${_startup_header}")
      set_source_files_properties("${_startup_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endif()
    set(_date_data_include "")
    set(_date_data_initializer "")
    set(_date_data_reference nullptr)
    string(JSON _date_namespace ERROR_VARIABLE _date_missing GET "${_behavior}" games "${_slug}" date_data)
    if(NOT _date_missing)
      if(NOT _date_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid date data namespace: ${_slug}")
      endif()
      set(_date_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/DateData.h")
      set(_date_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/DateData.cpp")
      if(NOT EXISTS "${_date_header}" OR NOT EXISTS "${_date_source}")
        message(FATAL_ERROR "Missing audited date data: ${_slug}")
      endif()
      set(_date_data_include "#include \"${_date_header}\"")
      set(_date_data_initializer "    static const DateWindowResourceProfile dateResources = ${_date_namespace}::Profile();")
      set(_date_data_reference "&dateResources")
      target_sources(${_native} PRIVATE "${_date_source}" "${_date_header}")
      set_source_files_properties("${_date_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endif()
    set(_countdown_data_include "")
    set(_countdown_data_initializer "")
    set(_countdown_data_reference nullptr)
    string(JSON _countdown_namespace ERROR_VARIABLE _countdown_data_missing GET "${_behavior}" games "${_slug}" five_frame_countdown_data)
    if(NOT _countdown_data_missing)
      if(NOT _countdown_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR NOT _countdown_enabled)
        message(FATAL_ERROR "Five-frame countdown requires a namespace and enabled layer: ${_slug}")
      endif()
      set(_countdown_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/CountdownData.h")
      set(_countdown_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/CountdownData.cpp")
      if(NOT EXISTS "${_countdown_header}" OR NOT EXISTS "${_countdown_source}")
        message(FATAL_ERROR "Missing audited countdown data: ${_slug}")
      endif()
      set(_countdown_data_include "#include \"${_countdown_header}\"")
      set(_countdown_data_initializer "    static const CountDownWindowFiveFrameResourceProfile fiveFrameCountdown = ${_countdown_namespace}::Resources();")
      set(_countdown_data_reference "&fiveFrameCountdown")
      target_sources(${_native} PRIVATE "${_countdown_source}" "${_countdown_header}")
      set_source_files_properties("${_countdown_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endif()
    set(_command_data_include "")
    set(_command_data_initializer "")
    set(_command_data_reference nullptr)
    string(JSON _command_namespace ERROR_VARIABLE _command_data_missing GET "${_behavior}" games "${_slug}" command_selection_data)
    if(NOT _command_data_missing)
      if(NOT _command_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid command-selection namespace: ${_slug}")
      endif()
      set(_command_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/CommandData.h")
      set(_command_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/CommandData.cpp")
      if(NOT EXISTS "${_command_header}" OR NOT EXISTS "${_command_source}")
        message(FATAL_ERROR "Missing audited command selection data: ${_slug}")
      endif()
      set(_command_data_include "#include \"${_command_header}\"")
      set(_command_data_initializer "    static const CommandSelectionResourceProfile commandSelection = ${_command_namespace}::Profile();")
      set(_command_data_reference "&commandSelection")
      target_sources(${_native} PRIVATE "${_command_source}" "${_command_header}")
      set_source_files_properties("${_command_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endif()
    set(_gauge_data_include "")
    set(_gauge_data_initializer "")
    set(_tokimeki_data_reference nullptr)
    set(_love_holic_data_reference nullptr)
    foreach(_gauge_kind tokimeki love_holic)
      string(JSON _gauge_namespace ERROR_VARIABLE _gauge_missing GET "${_behavior}" games "${_slug}" "${_gauge_kind}_gauge_data")
      if(NOT _gauge_missing)
        if(NOT _gauge_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR NOT _gauge_data_include STREQUAL "")
          message(FATAL_ERROR "Invalid or conflicting primary gauge profile: ${_slug}")
        endif()
        set(_gauge_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/GaugeData.h")
        set(_gauge_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/GaugeData.cpp")
        if(NOT EXISTS "${_gauge_header}" OR NOT EXISTS "${_gauge_source}")
          message(FATAL_ERROR "Missing audited gauge data: ${_slug}")
        endif()
        if(_gauge_kind STREQUAL "tokimeki")
          set(_gauge_type TokimekiGaugeResourceProfile)
        else()
          set(_gauge_type LoveHolicGaugesResourceProfile)
        endif()
        set(_gauge_data_include "#include \"${_gauge_header}\"")
        set(_gauge_data_initializer "    static const ${_gauge_type} gaugeResources = ${_gauge_namespace}::Profile();")
        set(_${_gauge_kind}_data_reference "&gaugeResources")
        target_sources(${_native} PRIVATE "${_gauge_source}" "${_gauge_header}")
        set_source_files_properties("${_gauge_source}" TARGET_DIRECTORY ${_native} PROPERTIES
          COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
          INCLUDE_DIRECTORIES "${_main_includes}")
      endif()
    endforeach()
    set(_music_data_include "")
    set(_music_data_initializer "")
    set(_music_data_reference nullptr)
    string(JSON _music_namespace ERROR_VARIABLE _music_missing GET "${_behavior}" games "${_slug}" music_data)
    if(NOT _music_missing)
      if(NOT _music_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid music resource namespace: ${_slug}")
      endif()
      set(_music_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/MusicData.h")
      set(_music_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/MusicData.cpp")
      if(NOT EXISTS "${_music_header}" OR NOT EXISTS "${_music_source}")
        message(FATAL_ERROR "Missing audited music data: ${_slug}")
      endif()
      set(_music_data_include "#include \"${_music_header}\"")
      set(_music_data_initializer "    static const MusicResourceProfile musicResources = ${_music_namespace}::Profile();")
      set(_music_data_reference "&musicResources")
      target_sources(${_native} PRIVATE "${_music_source}" "${_music_header}")
      set_source_files_properties("${_music_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endif()
    string(JSON _sound_page_namespace GET "${_behavior}" games "${_slug}" sound_page_data)
    if(NOT _sound_page_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
      message(FATAL_ERROR "Invalid sound page namespace: ${_slug}")
    endif()
    set(_sound_page_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/SoundPageData.h")
    set(_sound_page_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/SoundPageData.cpp")
    if(NOT EXISTS "${_sound_page_header}" OR NOT EXISTS "${_sound_page_source}")
      message(FATAL_ERROR "Missing audited sound page data: ${_slug}")
    endif()
    set(_sound_page_include "#include \"${_sound_page_header}\"")
    set(_sound_page_initializer "    static const SettingPage03ResourceProfile soundPage = ${_sound_page_namespace}::Profile();")
    target_sources(${_native} PRIVATE "${_sound_page_source}" "${_sound_page_header}")
    set_source_files_properties("${_sound_page_source}" TARGET_DIRECTORY ${_native} PROPERTIES
      COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
      INCLUDE_DIRECTORIES "${_main_includes}")
    foreach(_settings_kind shell text_display other)
      string(JSON _settings_namespace GET "${_behavior}" games "${_slug}" "settings_${_settings_kind}_data")
      if(NOT _settings_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid settings ${_settings_kind} namespace: ${_slug}")
      endif()
      if(_settings_kind STREQUAL "shell")
        set(_settings_basename SettingsShellData)
        set(_settings_type SettingShellResourceProfile)
      elseif(_settings_kind STREQUAL "text_display")
        set(_settings_basename SettingsTextDisplayData)
        set(_settings_type SettingTextDisplayResourceProfile)
      else()
        set(_settings_basename SettingsOtherData)
        set(_settings_type SettingOtherResourceProfile)
      endif()
      set(_settings_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/${_settings_basename}.h")
      set(_settings_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/${_settings_basename}.cpp")
      if(NOT EXISTS "${_settings_header}" OR NOT EXISTS "${_settings_source}")
        message(FATAL_ERROR "Missing audited settings ${_settings_kind} data: ${_slug}")
      endif()
      set(_settings_${_settings_kind}_include "#include \"${_settings_header}\"")
      set(_settings_${_settings_kind}_initializer "    static const ${_settings_type} settings_${_settings_kind} = ${_settings_namespace}::Profile();")
      target_sources(${_native} PRIVATE "${_settings_source}" "${_settings_header}")
      set_source_files_properties("${_settings_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endforeach()
    foreach(_appreciation_kind cg_page replay_page appreciation_scene option_characters cg_operation log_page save_load native_name general_confirm program_resources count_resources menu_selection legacy_character_selection likability item_acquisition legacy_map_selection)
      string(JSON _appreciation_value_type TYPE "${_behavior}" games "${_slug}" "${_appreciation_kind}_data")
      if(_appreciation_kind STREQUAL "native_name" AND _appreciation_value_type STREQUAL "NULL")
        set(_native_name_include "")
        set(_native_name_initializer "")
        set(_native_name_reference "nullptr")
        continue()
      endif()
      if(_appreciation_kind STREQUAL "menu_selection" AND _appreciation_value_type STREQUAL "NULL")
        set(_menu_selection_include "")
        set(_menu_selection_initializer "")
        set(_menu_selection_reference "nullptr")
        continue()
      endif()
      if(_appreciation_kind STREQUAL "item_acquisition" AND _appreciation_value_type STREQUAL "NULL")
        set(_item_acquisition_include "")
        set(_item_acquisition_initializer "")
        set(_item_acquisition_reference "nullptr")
        continue()
      endif()
      string(JSON _appreciation_namespace GET "${_behavior}" games "${_slug}" "${_appreciation_kind}_data")
      if(_appreciation_kind STREQUAL "program_resources" AND _appreciation_namespace STREQUAL "None")
        set(_program_resources_include "")
        set(_program_resources_initializer "    static const ProgramResourceProfile program_resources = NoProgramResourceProfile();")
        continue()
      endif()
      if(_appreciation_kind STREQUAL "count_resources" AND _appreciation_namespace STREQUAL "None")
        set(_count_resources_include "")
        set(_count_resources_initializer "    static const CountResourceProfile count_resources = NoCountResourceProfile();")
        continue()
      endif()
      if(_appreciation_kind STREQUAL "legacy_character_selection" AND _appreciation_namespace STREQUAL "None")
        set(_legacy_character_selection_include "")
        set(_legacy_character_selection_initializer "    static const auto& legacy_character_selection = NoLegacyCharacterSelectionProfile();")
        continue()
      endif()
      if(_appreciation_kind STREQUAL "legacy_map_selection" AND _appreciation_namespace STREQUAL "None")
        set(_legacy_map_selection_include "")
        set(_legacy_map_selection_initializer "    static const auto& legacy_map_selection = NoLegacyMapSelectionProfile();")
        continue()
      endif()
      if(NOT _appreciation_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid ${_appreciation_kind} namespace: ${_slug}")
      endif()
      if(_appreciation_kind STREQUAL "cg_page")
        set(_appreciation_basename CgPageData)
        set(_appreciation_type CgPageResourceProfile)
      elseif(_appreciation_kind STREQUAL "replay_page")
        set(_appreciation_basename ReplayPageData)
        set(_appreciation_type ReplayPageResourceProfile)
      elseif(_appreciation_kind STREQUAL "appreciation_scene")
        set(_appreciation_basename AppreciationSceneData)
        set(_appreciation_type AppreciationSceneResourceProfile)
      elseif(_appreciation_kind STREQUAL "option_characters")
        set(_appreciation_basename OptionCharData)
        set(_appreciation_type OptionCharResourceProfile)
      elseif(_appreciation_kind STREQUAL "cg_operation")
        set(_appreciation_basename CgOperationData)
        set(_appreciation_type CgOperationResourceProfile)
      elseif(_appreciation_kind STREQUAL "log_page")
        set(_appreciation_basename LogPageData)
        set(_appreciation_type LogPageResourceProfile)
      elseif(_appreciation_kind STREQUAL "save_load")
        set(_appreciation_basename SaveLoadData)
        set(_appreciation_type SaveLoadResourceProfile)
      elseif(_appreciation_kind STREQUAL "native_name")
        set(_appreciation_basename NativeNameData)
        set(_appreciation_type NameRegistrationResourceProfile)
        set(_native_name_reference "&native_name")
      elseif(_appreciation_kind STREQUAL "general_confirm")
        set(_appreciation_basename GeneralConfirmData)
        set(_appreciation_type GeneralConfirmResourceProfile)
      elseif(_appreciation_kind STREQUAL "count_resources")
        set(_appreciation_basename CountData)
        set(_appreciation_type CountResourceProfile)
      elseif(_appreciation_kind STREQUAL "menu_selection")
        set(_appreciation_basename MenuSelectionData)
        set(_appreciation_type LegacyMenuSelectionResourceProfile)
        set(_menu_selection_reference "&menu_selection")
      elseif(_appreciation_kind STREQUAL "legacy_character_selection")
        set(_appreciation_basename CharacterSelectionData)
        set(_appreciation_type LegacyCharacterSelectionProfile)
      elseif(_appreciation_kind STREQUAL "likability")
        set(_appreciation_basename LikabilityData)
        set(_appreciation_type LikabilityResourceProfile)
      elseif(_appreciation_kind STREQUAL "item_acquisition")
        set(_appreciation_basename ItemAcquisitionData)
        set(_appreciation_type LegacyItemAcquisitionResourceProfile)
        set(_item_acquisition_reference "&item_acquisition")
      elseif(_appreciation_kind STREQUAL "legacy_map_selection")
        set(_appreciation_basename MapSelectionData)
        set(_appreciation_type LegacyMapSelectionProfile)
      else()
        set(_appreciation_basename ProgramData)
        set(_appreciation_type ProgramResourceProfile)
      endif()
      set(_appreciation_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/${_appreciation_basename}.h")
      set(_appreciation_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/${_appreciation_basename}.cpp")
      if(NOT EXISTS "${_appreciation_header}" OR NOT EXISTS "${_appreciation_source}")
        message(FATAL_ERROR "Missing audited ${_appreciation_kind} data: ${_slug}")
      endif()
      set(_${_appreciation_kind}_include "#include \"${_appreciation_header}\"")
      set(_${_appreciation_kind}_initializer "    static const ${_appreciation_type} ${_appreciation_kind} = ${_appreciation_namespace}::Profile();")
      if(_appreciation_kind STREQUAL "menu_selection")
        set(_menu_selection_initializer "    static const auto& menu_selection = ${_appreciation_namespace}::Profile();")
      endif()
      if(_appreciation_kind STREQUAL "legacy_character_selection")
        set(_legacy_character_selection_initializer "    static const auto& legacy_character_selection = ${_appreciation_namespace}::Profile();")
      endif()
      if(_appreciation_kind STREQUAL "item_acquisition")
        set(_item_acquisition_initializer "    static const auto& item_acquisition = ${_appreciation_namespace}::Profile();")
      endif()
      if(_appreciation_kind STREQUAL "legacy_map_selection")
        set(_legacy_map_selection_initializer "    static const auto& legacy_map_selection = ${_appreciation_namespace}::Profile();")
      endif()
      target_sources(${_native} PRIVATE "${_appreciation_source}" "${_appreciation_header}")
      set_source_files_properties("${_appreciation_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endforeach()
    set(_mode_select_include "")
    set(_mode_select_provider MamatomoModeSelectButtonRecords)
    string(JSON _mode_select_namespace ERROR_VARIABLE _mode_select_missing GET "${_behavior}" games "${_slug}" mode_select_data)
    if(NOT _mode_select_missing)
      if(NOT _mode_select_namespace MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid mode-select resource namespace: ${_slug}")
      endif()
      set(_mode_select_header "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/ModeSelectData.h")
      set(_mode_select_source "${PROJECT_SOURCE_DIR}/Start/games/${_slug}/ModeSelectData.cpp")
      if(NOT EXISTS "${_mode_select_header}" OR NOT EXISTS "${_mode_select_source}")
        message(FATAL_ERROR "Missing audited mode-select data: ${_slug}")
      endif()
      set(_mode_select_include "#include \"${_mode_select_header}\"")
      set(_mode_select_provider "${_mode_select_namespace}::Records")
      target_sources(${_native} PRIVATE "${_mode_select_source}" "${_mode_select_header}")
      set_source_files_properties("${_mode_select_source}" TARGET_DIRECTORY ${_native} PROPERTIES
        COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
        INCLUDE_DIRECTORIES "${_main_includes}")
    endif()
    foreach(_capability env_read_color_byte startup_fullscreen_control mode_select_explicit_position)
      set(_${_capability} true)
      string(JSON _capability_type ERROR_VARIABLE _capability_missing TYPE "${_behavior}" games "${_slug}" "${_capability}")
      if(NOT _capability_missing)
        if(NOT _capability_type STREQUAL "BOOLEAN")
          message(FATAL_ERROR "${_capability} must be a JSON boolean: ${_slug}")
        endif()
        string(JSON _capability_value GET "${_behavior}" games "${_slug}" "${_capability}")
        if(NOT _capability_value)
          set(_${_capability} false)
        endif()
      endif()
    endforeach()
    string(JSON _menu_zone_type TYPE "${_behavior}" games "${_slug}" top_menu_requires_frame_left)
    if(NOT _menu_zone_type STREQUAL "BOOLEAN")
      message(FATAL_ERROR "top_menu_requires_frame_left must be explicit boolean: ${_slug}")
    endif()
    string(JSON _menu_zone_value GET "${_behavior}" games "${_slug}" top_menu_requires_frame_left)
    set(_top_menu_requires_frame_left false)
    if(_menu_zone_value)
      set(_top_menu_requires_frame_left true)
    endif()
    set(_profile "${CMAKE_BINARY_DIR}/generated/games/${_slug}/BuildProfile.cpp")
    string(JSON _legacy_display_family GET "${_behavior}" games "${_slug}" legacy_display_settings)
    if(NOT _legacy_display_family MATCHES "^(Disabled|Baku|Namaiki|ChuPet)$")
      message(FATAL_ERROR "Invalid audited legacy display family: ${_slug}")
    endif()
    configure_file("${PROJECT_SOURCE_DIR}/Start/games/BuildProfile.cpp.in" "${_profile}" @ONLY)
    set_source_files_properties("${_profile}" TARGET_DIRECTORY ${_native} PROPERTIES
      COMPILE_OPTIONS "${_main_options}" COMPILE_DEFINITIONS "${_main_definitions}"
      INCLUDE_DIRECTORIES "${_main_includes}")
    target_sources(${_native} PRIVATE "${_profile}")
    set_source_files_properties("${_entry}" TARGET_DIRECTORY ${_native}
      PROPERTIES INCLUDE_DIRECTORIES "${_resources}")
    file(GLOB_RECURSE _inputs CONFIGURE_DEPENDS
      "${_resources}/*.rc" "${_resources}/*.h" "${_resources}/*.bmp"
      "${_resources}/*.ico" "${_resources}/*.cur" "${_resources}/*.manifest")
    list(REMOVE_ITEM _inputs "${_entry}")
    set_source_files_properties(${_inputs} "${_metadata}" TARGET_DIRECTORY ${_native}
      PROPERTIES HEADER_FILE_ONLY TRUE)
    set_source_files_properties("${_entry}" TARGET_DIRECTORY ${_native}
      PROPERTIES OBJECT_DEPENDS "${_inputs}")
    target_sources(${_native} PRIVATE ${_inputs} "${_metadata}")
    # Start在导入子目录创建；目标级launcher也覆盖跨目录的Native直接链接。
    kaguya_bind_resource_metadata(${_native} "${_metadata}" "${_slug}")
    # 每次显式选择编号都会从对应缓存发布，避免切换游戏后沿用另一款的较新EXE。
    add_custom_target(${_public}
      COMMAND "${CMAKE_COMMAND}" -E make_directory "${KAGUYA_ARTIFACT_DIR}"
      COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:${_native}>" "${KAGUYA_ARTIFACT_DIR}/Start.exe"
      DEPENDS ${_native}
      COMMENT "Publishing ${_public}: ${_slug} -> Release/Start.exe"
      VERBATIM)
    list(APPEND _available "${_slug}")
    list(APPEND _targets "${_public}")
    if(_slug STREQUAL KAGUYA_GAME)
      set(_default_target "${_public}")
    endif()
  endforeach()
  if(NOT _default_target)
    message(FATAL_ERROR "Default resource profile is unknown or not prepared: ${KAGUYA_GAME}")
  endif()
  set_property(CACHE KAGUYA_GAME PROPERTY STRINGS ${_available})
  add_custom_target(KaGuYaProduction ALL DEPENDS ${_default_target} Graphics RenderDX Sound)
  message(STATUS "Game resource targets: ${_targets}; this does not certify runtime compatibility.")
endfunction()
