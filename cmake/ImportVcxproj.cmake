include_guard(GLOBAL)

function(_kaguya_import_get out object key default)
  string(JSON _value ERROR_VARIABLE _error GET "${object}" "${key}")
  if(_error)
    set(_value "${default}")
  endif()
  set(${out} "${_value}" PARENT_SCOPE)
endfunction()

function(_kaguya_import_path out value base)
  string(REPLACE "\\" "/" _path "${value}")
  cmake_path(ABSOLUTE_PATH _path BASE_DIRECTORY "${base}" NORMALIZE)
  if(NOT _path MATCHES "^([A-Za-z]:)?/$")
    string(REGEX REPLACE "/+$" "" _path "${_path}")
  endif()
  if(EXISTS "${_path}")
    file(REAL_PATH "${_path}" _path)
  else()
    get_filename_component(_parent "${_path}" DIRECTORY)
    get_filename_component(_leaf "${_path}" NAME)
    if(_parent STREQUAL _path OR _parent STREQUAL "")
      message(FATAL_ERROR "Cannot resolve MSBuild import path: ${value}")
    endif()
    _kaguya_import_path(_parent "${_parent}" "${base}")
    set(_path "${_parent}/${_leaf}")
    cmake_path(NORMAL_PATH _path)
  endif()
  set(${out} "${_path}" PARENT_SCOPE)
endfunction()

function(_kaguya_import_within path root)
  cmake_path(IS_PREFIX root "${path}" NORMALIZE _inside)
  if(NOT _inside)
    message(FATAL_ERROR "MSBuild import path is outside ${root}: ${path}")
  endif()
endfunction()

function(_kaguya_import_quote out value)
  string(REPLACE "\\" "/" _value "${value}")
  string(REPLACE "\"" "\\\"" _value "${_value}")
  string(REPLACE "$" "\\$" _value "${_value}")
  set(${out} "\"${_value}\"" PARENT_SCOPE)
endfunction()

function(_kaguya_import_json_quote out value)
  string(REPLACE "\\" "\\\\" _value "${value}")
  string(REPLACE "\"" "\\\"" _value "${_value}")
  string(REPLACE "\n" "\\n" _value "${_value}")
  string(REPLACE "\r" "\\r" _value "${_value}")
  string(REPLACE "\t" "\\t" _value "${_value}")
  set(${out} "\"${_value}\"" PARENT_SCOPE)
endfunction()

function(_kaguya_import_write path content)
  if(EXISTS "${path}")
    file(READ "${path}" _old)
    if(_old STREQUAL content)
      return()
    endif()
  endif()
  get_filename_component(_directory "${path}" DIRECTORY)
  file(MAKE_DIRECTORY "${_directory}")
  file(WRITE "${path}" "${content}")
endfunction()

function(_kaguya_import_fields out value)
  set(_fields "")
  foreach(_field IN LISTS value)
    if(NOT _field STREQUAL "" AND NOT _field MATCHES "^%\\(")
      list(APPEND _fields "${_field}")
    endif()
  endforeach()
  set(${out} "${_fields}" PARENT_SCOPE)
endfunction()

function(_kaguya_import_switches out value)
  # Preserve the old importer's non-POSIX shlex tokens, including quote characters.
  set(_switches "")
  while(NOT value STREQUAL "")
    string(REGEX REPLACE "^[ \t\r\n]+" "" value "${value}")
    if(value STREQUAL "")
      break()
    endif()
    if(value MATCHES "^\"")
      string(REGEX MATCH "^\"[^\"]*\"" _token "${value}")
    elseif(value MATCHES "^'")
      string(REGEX MATCH "^'[^']*'" _token "${value}")
    else()
      string(REGEX MATCH "^[^ \t\r\n]+" _token "${value}")
    endif()
    if(_token STREQUAL "")
      message(FATAL_ERROR "Unterminated quote in MSBuild options: ${value}")
    endif()
    string(LENGTH "${_token}" _length)
    string(SUBSTRING "${value}" ${_length} -1 value)
    string(REPLACE ";" "\\;" _token "${_token}")
    list(APPEND _switches "${_token}")
  endwhile()
  set(${out} "${_switches}" PARENT_SCOPE)
endfunction()

function(_kaguya_import_compile out_options out_language item vendor)
  string(JSON _path GET "${item}" FullPath)
  _kaguya_import_get(_compile_as "${item}" CompileAs Default)
  get_filename_component(_extension "${_path}" LAST_EXT)
  string(TOLOWER "${_extension}" _extension)
  set(_language CXX)
  if(_compile_as STREQUAL "CompileAsC" OR _extension STREQUAL ".c")
    set(_language C)
  endif()
  set(_options /W4 /GS /Oy- /fp:precise /Zi -Wno-invalid-offsetof)
  if(_language STREQUAL "CXX")
    _kaguya_import_get(_eh "${item}" ExceptionHandling Sync)
    if(_eh STREQUAL "Sync")
      list(APPEND _options /EHsc)
    elseif(_eh STREQUAL "SyncCThrow")
      list(APPEND _options /EHs /EHc-)
    elseif(_eh STREQUAL "Async")
      list(APPEND _options /EHa)
    else()
      message(FATAL_ERROR "Unmapped exception model ${_eh}: ${_path}")
    endif()
  endif()
  _kaguya_import_get(_optimization "${item}" Optimization "")
  if(_optimization STREQUAL "Disabled")
    list(APPEND _options /Od)
  endif()
  _kaguya_import_get(_inline "${item}" InlineFunctionExpansion "")
  if(_inline STREQUAL "Disabled")
    list(APPEND _options /Ob0)
  endif()
  _kaguya_import_get(_alignment "${item}" StructMemberAlignment Default)
  if(NOT _alignment STREQUAL "Default")
    if(_alignment STREQUAL "1Byte")
      list(APPEND _options /Zp1)
    elseif(_alignment MATCHES "^(2|4|8|16)Bytes$")
      list(APPEND _options "/Zp${CMAKE_MATCH_1}")
    else()
      message(FATAL_ERROR "Unmapped alignment ${_alignment}: ${_path}")
    endif()
  endif()
  _kaguya_import_get(_additional "${item}" AdditionalOptions "")
  _kaguya_import_switches(_additional "${_additional}")
  foreach(_option IN LISTS _additional)
    if(_option MATCHES "^%\\(" OR _option STREQUAL "/utf-8")
      continue()
    endif()
    string(TOLOWER "${_option}" _lower)
    if(_lower MATCHES "^[-/]std:")
      message(FATAL_ERROR "A file overrides the requested latest C++ standard: ${_path}")
    endif()
    list(APPEND _options "${_option}")
  endforeach()
  _kaguya_import_get(_calling "${item}" CallingConvention Cdecl)
  if(_calling STREQUAL "StdCall")
    list(APPEND _options /Gz)
  elseif(_calling STREQUAL "FastCall")
    list(APPEND _options /Gr)
  elseif(_calling STREQUAL "VectorCall")
    list(APPEND _options /Gv)
  elseif(NOT _calling STREQUAL "Cdecl")
    message(FATAL_ERROR "Unmapped calling convention ${_calling}: ${_path}")
  endif()
  _kaguya_import_get(_warnings "${item}" DisableSpecificWarnings "")
  _kaguya_import_fields(_warnings "${_warnings}")
  foreach(_warning IN LISTS _warnings)
    list(APPEND _options "/wd${_warning}")
  endforeach()
  _kaguya_import_get(_forced "${item}" ForcedIncludeFiles "")
  _kaguya_import_fields(_forced "${_forced}")
  foreach(_include IN LISTS _forced)
    list(APPEND _options "/FI${_include}")
  endforeach()
  if(vendor)
    list(APPEND _options -Wno-conversion -Wno-unused-parameter)
  endif()
  if(_language STREQUAL "CXX")
    list(APPEND _options "/FI${_root}/Common/include/CompilerCompatibility.h")
  endif()
  set(${out_options} "${_options}" PARENT_SCOPE)
  set(${out_language} "${_language}" PARENT_SCOPE)
endfunction()

function(_kaguya_import_query out project properties items)
  execute_process(COMMAND "${KAGUYA_MSBUILD}" "${project}" ${_query_arguments}
    "/getProperty:${properties}" "/getItem:${items}" ${ARGN}
    WORKING_DIRECTORY "${_root}" ENCODING UTF-8
    OUTPUT_VARIABLE _model ERROR_VARIABLE _error RESULT_VARIABLE _result)
  if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Read-only MSBuild evaluation failed for ${project} (${_result}):\n${_model}\n${_error}")
  endif()
  string(ASCII 239 187 191 _bom)
  string(REGEX REPLACE "^${_bom}" "" _model "${_model}")
  string(JSON _type ERROR_VARIABLE _json_error TYPE "${_model}")
  if(_json_error OR NOT _type STREQUAL "OBJECT")
    message(FATAL_ERROR "Invalid MSBuild JSON for ${project}: ${_json_error}\n${_model}")
  endif()
  set(${out} "${_model}" PARENT_SCOPE)
endfunction()

function(_kaguya_import_visit index order active out)
  if(index IN_LIST active)
    list(GET _projects ${index} _project)
    message(FATAL_ERROR "Cyclic ProjectReference graph at ${_project}")
  endif()
  if(NOT index IN_LIST order)
    list(APPEND active "${index}")
    foreach(_dependency IN LISTS _references_${index})
      list(FIND _projects "${_dependency}" _dependency_index)
      if(_dependency_index LESS 0)
        message(FATAL_ERROR "Unevaluated ProjectReference: ${_dependency}")
      endif()
      _kaguya_import_visit("${_dependency_index}" "${order}" "${active}" order)
    endforeach()
    list(APPEND order "${index}")
  endif()
  set(${out} "${order}" PARENT_SCOPE)
endfunction()

function(_kaguya_import_target index out_text out_summary out_count)
  list(GET _projects ${index} _project)
  get_filename_component(_project_dir "${_project}" DIRECTORY)
  set(_name "${_name_${index}}")
  set(_kind "${_kind_${index}}")
  set(_props "${_properties_${index}}")
  set(_link "${_link_${index}}")
  set(_sources "")
  set(_source_properties "")
  set(_source_count 0)
  set(_resource_count 0)
  set(_vendor FALSE)
  if(_name STREQUAL "KaGuYaVorbis")
    set(_vendor TRUE)
  endif()
  foreach(_category ClCompile ClInclude ResourceCompile)
    set(_array "${_items_${index}_${_category}}")
    string(JSON _count LENGTH "${_array}")
    if(_count EQUAL 0)
      continue()
    endif()
    math(EXPR _last "${_count} - 1")
    foreach(_item_index RANGE 0 ${_last})
      # Extract once: never parse the full project model for each metadata field.
      string(JSON _item GET "${_array}" ${_item_index})
      string(JSON _path GET "${_item}" FullPath)
      if(_category STREQUAL "ClCompile")
        _kaguya_import_get(_excluded "${_item}" ExcludedFromBuild false)
        string(TOLOWER "${_excluded}" _excluded)
        if(_excluded STREQUAL "true")
          continue()
        endif()
      endif()
      if(_category STREQUAL "ClInclude")
        if(NOT EXISTS "${_path}")
          continue()
        endif()
      else()
        if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
          message(FATAL_ERROR "Missing input ${_path}")
        endif()
        _kaguya_import_get(_pch "${_item}" PrecompiledHeader NotUsing)
        if(NOT _pch STREQUAL "NotUsing")
          message(FATAL_ERROR "Unmapped PCH in ${_path}: ${_pch}")
        endif()
      endif()
      _kaguya_import_quote(_quoted_path "${_path}")
      string(APPEND _sources "  ${_quoted_path}\n")
      if(_category STREQUAL "ClCompile")
        math(EXPR _source_count "${_source_count} + 1")
        _kaguya_import_compile(_options _language "${_item}" "${_vendor}")
        _kaguya_import_get(_includes "${_item}" AdditionalIncludeDirectories "")
        _kaguya_import_fields(_includes "${_includes}")
        _kaguya_import_get(_definitions "${_item}" PreprocessorDefinitions "")
        _kaguya_import_fields(_definitions "${_definitions}")
        _kaguya_import_quote(_includes "${_includes}")
        _kaguya_import_quote(_definitions "${_definitions}")
        _kaguya_import_quote(_options "${_options}")
        string(APPEND _source_properties
          "set_source_files_properties(${_quoted_path} PROPERTIES\n"
          "  LANGUAGE ${_language}\n"
          "  INCLUDE_DIRECTORIES ${_includes}\n"
          "  COMPILE_DEFINITIONS ${_definitions}\n"
          "  COMPILE_OPTIONS ${_options})\n")
      elseif(_category STREQUAL "ResourceCompile")
        math(EXPR _resource_count "${_resource_count} + 1")
        _kaguya_import_path(_resource_path "${_path}" "${_project_dir}")
        get_filename_component(_resource_dir "${_resource_path}" DIRECTORY)
        _kaguya_import_get(_includes "${_item}" AdditionalIncludeDirectories "")
        _kaguya_import_fields(_includes "${_includes}")
        list(PREPEND _includes "${_project_dir}" "${_resource_dir}")
        _kaguya_import_quote(_includes "${_includes}")
        string(APPEND _source_properties
          "set_source_files_properties(${_quoted_path} PROPERTIES\n"
          "  INCLUDE_DIRECTORIES ${_includes})\n")
      endif()
    endforeach()
  endforeach()
  if(_kind STREQUAL "StaticLibrary")
    set(_declaration "add_library(${_name} STATIC")
  elseif(_kind STREQUAL "DynamicLibrary")
    set(_declaration "add_library(${_name} SHARED")
  elseif(_kind STREQUAL "Application")
    set(_declaration "add_executable(${_name}")
    _kaguya_import_get(_subsystem "${_link}" SubSystem "")
    if(_subsystem STREQUAL "Windows")
      string(APPEND _declaration " WIN32")
    endif()
  else()
    message(FATAL_ERROR "Unsupported project type ${_kind}: ${_project}")
  endif()
  file(RELATIVE_PATH _relative "${_root}" "${_project}")
  set(_text "# Generated from ${_relative}; do not edit.\n${_declaration}\n${_sources}")
  _kaguya_import_get(_definition "${_link}" ModuleDefinitionFile "")
  if(NOT _definition STREQUAL "")
    _kaguya_import_quote(_definition "${_definition}")
    string(APPEND _text "  ${_definition}\n")
  endif()
  string(APPEND _text ")\n")
  string(JSON _out_dir GET "${_props}" OutDir)
  _kaguya_import_path(_out_dir "${_out_dir}" "${_root}")
  if(_kind STREQUAL "StaticLibrary")
    _kaguya_import_within("${_out_dir}" "${_build_root}")
    set(_archive_dir "${_out_dir}")
  else()
    _kaguya_import_within("${_out_dir}" "${_artifact_root}")
    set(_archive_dir "${_build_root}/lib/${CMAKE_BUILD_TYPE}/x86")
  endif()
  _kaguya_import_quote(_quoted_out "${_out_dir}")
  _kaguya_import_quote(_archive_dir "${_archive_dir}")
  _kaguya_import_quote(_pdb_dir "${_build_root}/symbols/${_name}")
  string(APPEND _text
    "set_target_properties(${_name} PROPERTIES\n"
    "  RUNTIME_OUTPUT_DIRECTORY ${_quoted_out}\n"
    "  LIBRARY_OUTPUT_DIRECTORY ${_quoted_out}\n"
    "  ARCHIVE_OUTPUT_DIRECTORY ${_archive_dir}\n"
    "  PDB_OUTPUT_DIRECTORY ${_pdb_dir}\n"
    "  WINDOWS_EXPORT_ALL_SYMBOLS OFF)\n"
    "source_group(TREE \"\${PROJECT_SOURCE_DIR}\" FILES\n${_sources})\n"
    "${_source_properties}")
  set(_reference_index 0)
  foreach(_dependency IN LISTS _references_${index})
    list(FIND _projects "${_dependency}" _dep_index)
    set(_dep_name "${_name_${_dep_index}}")
    set(_dep_kind "${_kind_${_dep_index}}")
    list(GET _reference_links_${index} ${_reference_index} _link_dependency)
    if(_link_dependency AND _dep_kind MATCHES "^(StaticLibrary|DynamicLibrary)$")
      if(_kind STREQUAL "StaticLibrary")
        # MSBuild does not merge these archives; retain final-link transitivity.
        string(APPEND _text "target_link_libraries(${_name} INTERFACE ${_dep_name})\n"
          "add_dependencies(${_name} ${_dep_name})\n")
      else()
        string(APPEND _text "target_link_libraries(${_name} PRIVATE ${_dep_name})\n")
      endif()
    else()
      string(APPEND _text "add_dependencies(${_name} ${_dep_name})\n")
    endif()
    math(EXPR _reference_index "${_reference_index} + 1")
  endforeach()
  if(NOT _kind STREQUAL "StaticLibrary")
    _kaguya_import_get(_libraries "${_link}" AdditionalDependencies "")
    _kaguya_import_fields(_libraries "${_libraries}")
    if(_libraries)
      string(APPEND _text "target_link_libraries(${_name} PRIVATE")
      foreach(_library IN LISTS _libraries)
        _kaguya_import_quote(_library "${_library}")
        string(APPEND _text " ${_library}")
      endforeach()
      string(APPEND _text ")\n")
    endif()
    set(_options /DEBUG /INCREMENTAL:NO)
    _kaguya_import_get(_additional "${_link}" AdditionalOptions "")
    _kaguya_import_switches(_additional "${_additional}")
    list(APPEND _options ${_additional})
    _kaguya_import_get(_manifest "${_props}" GenerateManifest "")
    string(TOLOWER "${_manifest}" _manifest)
    if(_manifest STREQUAL "false")
      list(APPEND _options /MANIFEST:NO)
    endif()
    _kaguya_import_get(_folding "${_link}" EnableCOMDATFolding "")
    if(_folding STREQUAL "true")
      list(APPEND _options /OPT:ICF)
    endif()
    _kaguya_import_get(_opt_refs "${_link}" OptimizeReferences "")
    if(_opt_refs STREQUAL "true")
      list(APPEND _options /OPT:REF)
    endif()
    string(APPEND _text "target_link_options(${_name} PRIVATE")
    foreach(_option IN LISTS _options)
      if(NOT _option MATCHES "^%\\(")
        _kaguya_import_quote(_option "${_option}")
        string(APPEND _text " ${_option}")
      endif()
    endforeach()
    string(APPEND _text ")\n")
  endif()
  set(_summary "{}")
  string(REPLACE "/" "\\" _summary_project "${_relative}")
  string(REPLACE "/" "\\" _summary_output "${_out_dir}")
  foreach(_field target project type output)
    if(_field STREQUAL "target")
      set(_value "${_name}")
    elseif(_field STREQUAL "project")
      set(_value "${_summary_project}")
    elseif(_field STREQUAL "type")
      set(_value "${_kind}")
    else()
      set(_value "${_summary_output}")
    endif()
    _kaguya_import_json_quote(_value "${_value}")
    string(JSON _summary SET "${_summary}" "${_field}" "${_value}")
  endforeach()
  string(JSON _summary SET "${_summary}" sources ${_source_count})
  string(JSON _summary SET "${_summary}" resources ${_resource_count})
  set(${out_text} "${_text}" PARENT_SCOPE)
  set(${out_summary} "${_summary}" PARENT_SCOPE)
  set(${out_count} "${_source_count}" PARENT_SCOPE)
endfunction()

function(kaguya_import_projects)
  foreach(_required PROJECT_SOURCE_DIR CMAKE_BINARY_DIR KAGUYA_MSBUILD KAGUYA_ARTIFACT_DIR)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
      message(FATAL_ERROR "Missing MSBuild import configuration: ${_required}")
    endif()
  endforeach()
  if(NOT CMAKE_BUILD_TYPE MATCHES "^(Debug|Release)$")
    message(FATAL_ERROR "MSBuild import requires Debug or Release.")
  endif()
  if(NOT "${_kaguya_logging_value}" MATCHES "^[01]$")
    message(FATAL_ERROR "MSBuild import requires _kaguya_logging_value=0 or 1.")
  endif()
  _kaguya_import_path(_root "${PROJECT_SOURCE_DIR}" "${PROJECT_SOURCE_DIR}")
  _kaguya_import_path(_binary_root "${CMAKE_BINARY_DIR}" "${_root}")
  _kaguya_import_path(_build_root "${_binary_root}/artifacts" "${_root}")
  _kaguya_import_path(_artifact_root "${KAGUYA_ARTIFACT_DIR}" "${_root}")
  _kaguya_import_within("${_binary_root}" "${_root}/.BuildCache")
  _kaguya_import_within("${_artifact_root}" "${_root}/Release")
  set(KAGUYA_MODEL_DIR "${_binary_root}/generated/msbuild")
  set(_metadata_import "${_root}/cmake/ExportProjectMetadata.targets")
  set(_query_arguments /nologo "/p:Configuration=${CMAKE_BUILD_TYPE}" /p:Platform=Win32
    /p:VisualStudioVersion=17.0 "/p:KaGuYaEnableLogging=${_kaguya_logging_value}"
    "/p:KaGuYaBuildRoot=${_build_root}/" "/p:KaGuYaOutputRoot=${_artifact_root}/"
    "/p:ForceImportAfterCppTargets=${_metadata_import}")
  set(_probe "${KAGUYA_MODEL_DIR}/ReferenceDefaults.props")
  # Cpp.Common.props defaults static-library references to false. A second,
  # evaluation-only query changes that default; item-level false still wins,
  # including conditional metadata and imported references. No XML heuristics.
  _kaguya_import_write("${_probe}" [=[<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup Condition="'$(ConfigurationType)' == 'StaticLibrary'">
    <ProjectReference><LinkLibraryDependencies>true</LinkLibraryDependencies></ProjectReference>
  </ItemDefinitionGroup>
</Project>
]=])
  set(_pending "${_root}/Start/Start.vcxproj" "${_root}/Graphics/Graphics.vcxproj"
    "${_root}/RenderDX/RenderDX.vcxproj" "${_root}/Sound/Sound.vcxproj")
  set(_projects "")
  set(_names "")
  set(_watch "${_root}/Directory.Build.props" "${_metadata_import}"
    "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" "${_root}/cmake/msvc_environment.cmd")
  while(_pending)
    list(POP_FRONT _pending _project)
    _kaguya_import_path(_project "${_project}" "${_root}")
    if(_project IN_LIST _projects)
      continue()
    endif()
    _kaguya_import_within("${_project}" "${_root}")
    list(LENGTH _projects _index)
    list(APPEND _projects "${_project}")
    _kaguya_import_query(_model "${_project}"
      "TargetName,ConfigurationType,OutDir,IntDir,GenerateManifest,MSBuildAllProjects"
      "ClCompile,ClInclude,ResourceCompile,ProjectReference,Link")
    string(JSON _props GET "${_model}" Properties)
    string(JSON _items GET "${_model}" Items)
    unset(_model)
    string(JSON _name GET "${_props}" TargetName)
    string(JSON _kind GET "${_props}" ConfigurationType)
    if(_name IN_LIST _names)
      message(FATAL_ERROR "Duplicate target output name requires an explicit mapping: ${_name}")
    endif()
    if(NOT _name MATCHES "^[A-Za-z0-9_.+-]+$")
      message(FATAL_ERROR "Unsupported CMake target name: ${_name}")
    endif()
    list(APPEND _names "${_name}")
    set(_name_${_index} "${_name}")
    set(_kind_${_index} "${_kind}")
    set(_properties_${_index} "${_props}")
    foreach(_category ClCompile ClInclude ResourceCompile ProjectReference Link)
      _kaguya_import_get(_items_${_index}_${_category} "${_items}" "${_category}" "[]")
    endforeach()
    unset(_items)
    string(JSON _link_count LENGTH "${_items_${_index}_Link}")
    if(NOT _link_count EQUAL 1)
      message(FATAL_ERROR "No unique evaluated Link metadata for ${_project}")
    endif()
    string(JSON _link_${_index} GET "${_items_${_index}_Link}" 0)
    set(_references_${_index} "")
    set(_reference_links_${_index} "")
    set(_references "${_items_${_index}_ProjectReference}")
    string(JSON _reference_count LENGTH "${_references}")
    if(_reference_count GREATER 0)
      if(_kind STREQUAL "StaticLibrary")
        _kaguya_import_query(_probe_model "${_project}" ConfigurationType ProjectReference
          "/p:ForceImportAfterCppProps=${_probe}")
        string(JSON _probe_kind GET "${_probe_model}" Properties ConfigurationType)
        string(JSON _probe_references GET "${_probe_model}" Items ProjectReference)
        unset(_probe_model)
        string(JSON _probe_count LENGTH "${_probe_references}")
        if(NOT _probe_kind STREQUAL _kind OR NOT _probe_count EQUAL _reference_count)
          message(FATAL_ERROR "Reference-default probe changed the project graph: ${_project}")
        endif()
      endif()
      math(EXPR _last "${_reference_count} - 1")
      foreach(_reference_index RANGE 0 ${_last})
        string(JSON _reference GET "${_references}" ${_reference_index})
        string(JSON _dependency GET "${_reference}" FullPath)
        _kaguya_import_path(_dependency "${_dependency}" "${_root}")
        _kaguya_import_get(_link_dependency "${_reference}" LinkLibraryDependencies true)
        string(TOLOWER "${_link_dependency}" _link_dependency)
        if(NOT _link_dependency MATCHES "^(true|false)$")
          message(FATAL_ERROR "Invalid LinkLibraryDependencies for ${_project}: ${_reference}")
        endif()
        if(_kind STREQUAL "StaticLibrary")
          string(JSON _probe_reference GET "${_probe_references}" ${_reference_index})
          string(JSON _probe_path GET "${_probe_reference}" FullPath)
          _kaguya_import_path(_probe_path "${_probe_path}" "${_root}")
          string(JSON _probe_link GET "${_probe_reference}" LinkLibraryDependencies)
          string(TOLOWER "${_probe_link}" _probe_link)
          if(NOT _probe_path STREQUAL _dependency OR NOT _probe_link MATCHES "^(true|false)$"
             OR (_link_dependency STREQUAL "true" AND _probe_link STREQUAL "false"))
            message(FATAL_ERROR "Inconsistent reference-default probe for ${_project}: ${_dependency}")
          endif()
          set(_link_dependency "${_probe_link}")
        endif()
        list(APPEND _references_${_index} "${_dependency}")
        list(APPEND _reference_links_${_index} "${_link_dependency}")
      endforeach()
      list(PREPEND _pending ${_references_${_index}})
    endif()
    _kaguya_import_get(_imports "${_props}" MSBuildAllProjects "")
    _kaguya_import_fields(_imports "${_imports}")
    foreach(_import IN LISTS _imports)
      _kaguya_import_path(_import "${_import}" "${_root}")
      if(EXISTS "${_import}")
        list(APPEND _watch "${_import}")
      endif()
    endforeach()
  endwhile()
  set(_order "")
  list(LENGTH _projects _project_count)
  math(EXPR _last "${_project_count} - 1")
  foreach(_index RANGE 0 ${_last})
    _kaguya_import_visit("${_index}" "${_order}" "" _order)
  endforeach()
  set(_target_index "")
  set(_summaries "[]")
  set(_summary_index 0)
  set(_source_total 0)
  foreach(_index IN LISTS _order)
    _kaguya_import_target("${_index}" _text _summary _source_count)
    set(_name "${_name_${_index}}")
    _kaguya_import_write("${KAGUYA_MODEL_DIR}/${_name}.cmake" "${_text}")
    _kaguya_import_quote(_quoted_name "${_name}")
    string(APPEND _target_index "set(KAGUYA_IMPORT_KEY ${_quoted_name})\n"
      "add_subdirectory(\"\${PROJECT_SOURCE_DIR}/cmake/Imported\" \"\${CMAKE_BINARY_DIR}/targets/${_name}\")\n")
    string(JSON _summaries SET "${_summaries}" ${_summary_index} "${_summary}")
    math(EXPR _summary_index "${_summary_index} + 1")
    math(EXPR _source_total "${_source_total} + ${_source_count}")
  endforeach()
  # This glob watches metadata only; source membership comes exclusively from MSBuild.
  file(GLOB _resource_targets LIST_DIRECTORIES FALSE "${_root}/Start/resources/*.targets")
  list(APPEND _watch ${_projects} ${_resource_targets})
  list(REMOVE_DUPLICATES _watch)
  string(APPEND _target_index "set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS\n")
  foreach(_path IN LISTS _watch)
    _kaguya_import_quote(_path "${_path}")
    string(APPEND _target_index "  ${_path}\n")
  endforeach()
  string(APPEND _target_index ")\n")
  _kaguya_import_write("${KAGUYA_MODEL_DIR}/targets.cmake" "${_target_index}")
  _kaguya_import_json_quote(_configuration "${CMAKE_BUILD_TYPE}")
  string(JSON _summary SET "{}" configuration "${_configuration}")
  string(JSON _summary SET "${_summary}" projects "${_summaries}")
  _kaguya_import_write("${KAGUYA_MODEL_DIR}/summary.json" "${_summary}\n")
  set(KAGUYA_MODEL_DIR "${KAGUYA_MODEL_DIR}" PARENT_SCOPE)
  message(STATUS "Imported ${_project_count} projects / ${_source_total} translation units.")
endfunction()
