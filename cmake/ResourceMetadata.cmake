# JSON由CMake解析；原生链接工具只接受严格、可审查的类型化记录。
function(kaguya_bind_resource_metadata target metadata slug)
  file(READ "${metadata}" _json)
  string(JSON _schema GET "${_json}" schema_version)
  if(NOT _schema STREQUAL "1")
    message(FATAL_ERROR "Unsupported resource metadata schema: ${metadata}")
  endif()
  string(JSON _rows GET "${_json}" resources)
  string(JSON _count LENGTH "${_rows}")
  set(_table "KAGUYA_RESOURCE_METADATA_V1\n")
  set(_keys "")
  if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
      string(JSON _row GET "${_rows}" ${_index})
      string(JSON _length LENGTH "${_row}" key)
      if(NOT _length EQUAL 3)
        message(FATAL_ERROR "Resource key must have type, ID and language")
      endif()
      set(_key "")
      foreach(_part RANGE 0 2)
        string(JSON _kind TYPE "${_row}" key ${_part})
        string(JSON _value GET "${_row}" key ${_part})
        if(_kind STREQUAL "NUMBER")
          if(NOT _value MATCHES "^[0-9]+$" OR _value GREATER 4294967295)
            message(FATAL_ERROR "Invalid numeric resource key: ${metadata}")
          endif()
          list(APPEND _key "n${_value}")
        elseif(_kind STREQUAL "STRING")
          string(HEX "${_value}" _hex)
          list(APPEND _key "s${_hex}")
        else()
          message(FATAL_ERROR "Unsupported resource key type: ${_kind}")
        endif()
      endforeach()
      list(JOIN _key " " _key_line)
      if(_key_line IN_LIST _keys)
        message(FATAL_ERROR "Duplicate resource key: ${metadata}")
      endif()
      list(APPEND _keys "${_key_line}")
      string(JSON _cp_type TYPE "${_row}" codepage)
      string(JSON _cp GET "${_row}" codepage)
      if(NOT _cp_type STREQUAL "NUMBER" OR NOT _cp MATCHES "^[0-9]+$" OR _cp GREATER 4294967295)
        message(FATAL_ERROR "Invalid resource CodePage: ${metadata}")
      endif()
      string(APPEND _table "${_key_line} ${_cp}\n")
    endforeach()
  endif()
  set(_table_path "${CMAKE_BINARY_DIR}/generated/resource-metadata/${slug}.txt")
  file(GENERATE OUTPUT "${_table_path}" CONTENT "${_table}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${metadata}")
  add_dependencies(${target} KaGuYaResourceMetadata)
  set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS
    "${metadata}" "${_table_path}" "$<TARGET_FILE:KaGuYaResourceMetadata>")
  set_property(TARGET ${target} PROPERTY CXX_LINKER_LAUNCHER
    "$<TARGET_FILE:KaGuYaResourceMetadata>;--root;${PROJECT_SOURCE_DIR};--image;$<TARGET_FILE:${target}>;--table;${_table_path};--")
endfunction()
