namespace KaGuYa::Start::Runtime
{
const GameBuildProfile& CompiledGameProfile() noexcept
{
@_title_data_initializer@
@_startup_data_initializer@
@_date_data_initializer@
@_countdown_data_initializer@
@_command_data_initializer@
@_gauge_data_initializer@
@_music_data_initializer@
@_sound_page_initializer@
@_settings_shell_initializer@
@_settings_text_display_initializer@
@_settings_other_initializer@
@_cg_page_initializer@
@_replay_page_initializer@
@_appreciation_scene_initializer@
@_option_characters_initializer@
@_cg_operation_initializer@
@_log_page_initializer@
@_save_load_initializer@
@_native_name_initializer@
@_general_confirm_initializer@
@_program_resources_initializer@
@_count_resources_initializer@
@_menu_selection_initializer@
@_legacy_character_selection_initializer@
@_likability_initializer@
@_item_acquisition_initializer@
@_legacy_map_selection_initializer@
    static const GameBuildProfile profile{
        "@_slug@", {TitleDialogFamily::@_title_family@, TitleNamePromptGate::@_title_gate@,
            TitleButtonResources::@_title_resources@, TitlePhase5Recovery::@_title_recovery@, @_title_data_reference@},
        GameBuildProfile::SoundSettings::@_sound_settings@,
        GameBuildProfile::StartupResources::@_startup_resources@,
        &@_script_names_provider@, @_countdown_enabled@, @_wait_skip_result@, @_restart_point@,
        &@_text_layout_provider@, @_startup_data_reference@, @_date_data_reference@,
        @_countdown_data_reference@, @_command_data_reference@,
        @_tokimeki_data_reference@, @_love_holic_data_reference@, @_music_data_reference@,
        @_env_read_color_byte@, @_startup_fullscreen_control@, &@_mode_select_provider@,
        @_mode_select_explicit_position@, &soundPage, &settings_shell, &settings_text_display,
        @_top_menu_requires_frame_left@, LegacyDisplaySettingsFamily::@_legacy_display_family@, &settings_other,
        &cg_page, &replay_page, &appreciation_scene, &option_characters,
        &cg_operation, &log_page, &save_load,
        @_native_name_reference@, &general_confirm, &program_resources, &count_resources,
        @_menu_selection_reference@, &legacy_character_selection, &likability,
        @_item_acquisition_reference@, &legacy_map_selection};
    return profile;
}
